{
  "id": "bodian",
  "name": "Bodian Music",
  "version": "0.1.0",
  "minAppVersion": "0.1.16",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": ["bd-api.kuwo.cn", "mlyric.kuwo.cn"]
  },
  "settings": [
    {
      "key": "quality",
      "label": "Quality Override",
      "help": "standard, high or lossless. Leave empty to follow the player."
    }
  ],
  "navigation": [
    { "title": "Discover", "builtin": "home", "icon": "home" },
    { "title": "Daily Picks", "page": "daily", "icon": "calendar" },
    { "title": "Charts", "page": "charts", "icon": "chart" },
    { "title": "Playlist Square", "page": "square", "icon": "playlist" },
    { "title": "Liked Songs", "builtin": "liked", "icon": "heart" }
  ]
}
